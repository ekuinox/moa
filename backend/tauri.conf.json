{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moa",
  "version": "0.1.0",
  "identifier": "dev.ekuinox.moa",
  "build": {
    "beforeDevCommand": "pnpm.cmd dev",
    "beforeBuildCommand": "pnpm.cmd build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "moa",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
